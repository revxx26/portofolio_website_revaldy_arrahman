{
  "name": "revaldy-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-export.cjs && node scripts/verify-browser-compat.cjs",
    "preview": "node scripts/preview-static.cjs",
    "cms:dev": "npm --prefix studio run dev",
    "cms:login": "npm --prefix studio run login",
    "cms:seed": "npm --prefix studio run seed",
    "cms:build": "npm --prefix studio run build",
    "cms:deploy": "npm --prefix studio run deploy",
    "cms:test": "node scripts/test-cms.mjs"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.3",
    "ios_saf 16.3"
  ],
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "acorn": "8.15.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
